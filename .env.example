# GoCardless API Credentials
# Get these from: https://bankaccountdata.gocardless.com/user-secrets/
GOCARDLESS_SECRET_ID=your_secret_id_here
GOCARDLESS_SECRET_KEY=your_secret_key_here

# Environment: sandbox or production
GOCARDLESS_ENVIRONMENT=sandbox

# Anthropic API Key (for AI categorization)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
